{
	"name": "banggai-escape",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "pnpm --filter @banggai/web dev",
		"build": "pnpm --filter @banggai/web build",
