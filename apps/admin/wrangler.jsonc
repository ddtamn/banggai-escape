{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "admin",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Uploaded media. `media.banggaiescape.com` is a custom domain on this bucket, so
	// objects are read straight from R2's edge with no Worker in the path. The
	// `r2.dev` public URL stays **disabled**: it is rate-limited, not a production host.
	"r2_buckets": [
		{
			"binding": "R2_MEDIA",
			"bucket_name": "banggaiescape-media"
		}
	],
	"vars": {
		// Where a published media object is read from. A var rather than a constant so
		// `wrangler dev` can leave it empty and fall back to this Worker's own
		// `/media/<key>` route — a local upload is written to the local R2 simulation, so it
		// does not exist on the production host. See MEDIA_PUBLIC_URL in docs/14.
		"MEDIA_PUBLIC_URL": "https://media.banggaiescape.com",
		// Which account's Analytics Engine dataset the analytics dashboard reads. An
		// identifier, not a credential, so it belongs here rather than in a secret — but it
		// does change between accounts, which is why it is not a constant in the code. The
		// token that goes with it is a secret: see CLOUDFLARE_ANALYTICS_TOKEN in docs/14.
		"CLOUDFLARE_ACCOUNT_ID": "91a7dd704831e7143ccf6525c5c04b92",
		// Better Auth uses this as its `baseURL`, for the session cookie and for the
		// callback it returns to. It must be the **exact** deployed origin: a mismatch is
		// why sign-in can appear to work and then drop the session on the next request.
		// So it is a var rather than a secret, and it is the reason `workers_dev` is off
		// below — a second hostname serving the same app is a second origin, and one the
		// admin has no reason to answer on.
		"ORIGIN": "https://admin.banggaiescape.com"
	},
	// The custom domain. Wrangler creates the DNS record and the route together, so the
	// zone needs no manual record — but the deploying token needs Zone/DNS edit for the
	// zone, and a Workers Scripts edit for the account.
	"routes": [
		{
			"pattern": "admin.banggaiescape.com",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	"preview_urls": true
}
