# Local development values for the public site. Copy to `.env`; `.env` is git-ignored,
# so never commit a real connection string.
#
# `vite dev` reads `.env` and `pnpm preview` (the built Worker) reads `.dev.vars` —
# wrangler never reads `.env`. Both are git-ignored.

# The Neon connection the site reads published content with. Copy it from
# `apps/admin/.env`, which means local dev connects as `neondb_owner`. That is fine on a
# laptop and wrong for a deployment: the deployed Worker must use the read-only
# `banggai_web` role (`pnpm --filter @banggai/admin db:roles`) and hold it as a secret.
# See docs/11-deployment.md#environment-and-secrets.
DATABASE_URL="postgresql://user:password@host/db-name?sslmode=require"

# Where published media is read from. This one is *not* a secret: it has the same value
# as the `MEDIA_PUBLIC_URL` var in `apps/web/wrangler.jsonc`, and it is only listed here
# because `vite dev` does not read the wrangler config.
MEDIA_PUBLIC_URL=https://media.banggaiescape.com
