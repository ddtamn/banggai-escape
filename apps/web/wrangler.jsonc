{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "banggai-escape",
	"compatibility_date": "2026-09-24",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Where a published media object is read from: the R2 custom domain, not the bucket itself.
	// A var rather than a constant so a local run can point somewhere else — and, because this
	// site has no `/media/<key>` fallback of its own, so that a missing value is a startup error
	// naming MEDIA_PUBLIC_URL rather than a page full of broken images. See
	// docs/08-content-data-layer.md#media-ts--ids-to-urls.
	//
	// DATABASE_URL is deliberately absent: it is a secret, set with `wrangler secret put` in
	// production and supplied by .env / .dev.vars locally.
	"vars": {
		"MEDIA_PUBLIC_URL": "https://media.banggaiescape.com"
	},
	// One data point per navigation and per tracked click, written here rather than by the
	// browser so that a blocked beacon cannot silently hide a page view. Cloudflare creates
	// the dataset on the first write, so this is the only place its name is declared — rename
	// it and you start a second, empty table. The column layout is fixed in
	// `@banggai/content-model` (`analytics.ts`) and read back by the admin.
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "BANGGAI_SITE_EVENTS"
		}
	],
	"workers_dev": true,
	"preview_urls": true
}
