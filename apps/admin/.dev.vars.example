[TEMPLATE]
# Local `wrangler dev` bindings. Copy to `.dev.vars` (git-ignored).
#
# Wrangler reads `.env` for its own configuration and this file for the Worker's `env`,
# so the two are not interchangeable. Values here override `vars` in `wrangler.jsonc`,
# and anything listed as a secret (`wrangler secret put <NAME>`) belongs here locally.

# Blank on purpose in local development. `wrangler.jsonc` points this at the production
# media host, but a local upload is written to the local R2 simulation, so that host
# does not have the bytes. Empty means `publicMediaUrl()` falls back to this Worker's own
# `/media/<key>` route, which reads the local bucket.
MEDIA_PUBLIC_URL=""

# The app's runtime variables. **These are required to run the built Worker** —
# `pnpm --filter @banggai/admin preview` serves `.svelte-kit/cloudflare/_worker.js` under
# `wrangler dev`, and that Worker's `env` comes from this file alone. A checkout whose
# values only live in `.env` answers `500 · DATABASE_URL is not set` on every route.
#
# `pnpm dev` does not need them here: SvelteKit's dev server fills
# `$env/dynamic/private` from `.env`, which is exactly why this is easy to miss until the
# first time you preview. Copy each value across from `.env` to preview locally, and in
# production supply them with `wrangler secret put` instead of a file.
# BETTER_AUTH_SECRET=""
# DATABASE_URL=""
# ORIGIN=""
