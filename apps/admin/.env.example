# Drizzle
# Pooled connection string — used by the app at runtime and by `drizzle-kit studio`.
# Keep it unquoted when you override it on the command line: a quoted value makes
# drizzle-kit fail silently.
DATABASE_URL="postgres://user:password@host:port/db-name"

# Optional direct (non-pooled) connection. `drizzle-kit migrate` prefers it when set,
# because migrations run DDL. `neon env pull` writes both.
# DATABASE_URL_UNPOOLED="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Cloudflare CLI
# Not read by the app — only by `wrangler` itself, so that bucket and deploy commands run
# without an interactive `wrangler login`. Leave it out of `.dev.vars`: wrangler reads
# `.env` for its own credentials and `.dev.vars` for the Worker's env, so a token there is
# ignored. Scopes needed: Workers R2 Storage → Edit, Account Settings → Read, and — for
# the media custom domain — Zone → Zone → Read plus DNS → Edit. Never commit it.
# CLOUDFLARE_API_TOKEN=""

# Database roles
# Only read by `pnpm --filter @banggai/admin db:roles`, which creates the two roles and grants
# them least privilege (banggai_admin writes, banggai_web may only read the content
# tables). Not read by the app. Generate each with `openssl rand -hex 24`; the letters,
# digits, and `. _ ~ ! * ( ) -` alphabet is the only one the script accepts. Never commit
# them — put them in the Worker's secrets and in your password manager.
#
# Administrator membership is NOT configured here. It is a row in the `administrators`
# table, granted by `pnpm --filter @banggai/admin provision`, so access can be revoked per person
# without a redeploy.
# ADMIN_DB_PASSWORD=""
# WEB_DB_PASSWORD=""
